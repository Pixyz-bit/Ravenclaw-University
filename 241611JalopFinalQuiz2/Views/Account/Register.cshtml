@model _241611JalopFinalQuiz2.ViewModels.RegisterViewModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = "Student registration"; }
<div class="account-form-wrap registration-wrap">
    <p class="eyebrow">A new beginning</p>
    <h1>Make room for discovery.</h1>
    <p class="intro">Create your student account. Fields marked * are required.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="FirstName">First name *</label>
                <input asp-for="FirstName" autocomplete="given-name" maxlength="100" aria-required="true" aria-describedby="first-error" />
                <span asp-validation-for="FirstName" id="first-error" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="LastName">Last name *</label>
                <input asp-for="LastName" autocomplete="family-name" maxlength="100" aria-required="true" aria-describedby="last-error" />
                <span asp-validation-for="LastName" id="last-error" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="MiddleName">Middle name <span class="optional">(optional)</span></label>
                <input asp-for="MiddleName" autocomplete="additional-name" maxlength="100" aria-describedby="middle-error" />
                <span asp-validation-for="MiddleName" id="middle-error" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Birthday">Birthday <span class="optional">(optional)</span></label>
                <input asp-for="Birthday" type="date" autocomplete="bday" aria-describedby="birthday-error" />
                <span asp-validation-for="Birthday" id="birthday-error" class="field-error"></span>
            </div>
        </div>
        <div class="field">
            <label asp-for="Username">Username *</label>
            <input asp-for="Username" autocomplete="username" maxlength="100" aria-required="true" aria-describedby="username-help username-error" />
            <small id="username-help">3–100 characters. Letters, numbers, periods, underscores, or hyphens.</small>
            <span asp-validation-for="Username" id="username-error" class="field-error"></span>
        </div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Password">Password *</label>
                <input asp-for="Password" autocomplete="new-password" maxlength="128" aria-required="true" aria-describedby="password-help password-error" />
                <small id="password-help">Use 8–128 characters.</small>
                <span asp-validation-for="Password" id="password-error" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm password *</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" maxlength="128" aria-required="true" aria-describedby="confirm-error" />
                <span asp-validation-for="ConfirmPassword" id="confirm-error" class="field-error"></span>
            </div>
        </div>
        <button class="button button-primary" type="submit">Create student account <span aria-hidden="true">→</span></button>
    </form>
    <p class="account-switch">Already have an account? <a asp-action="Login">Sign in</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
