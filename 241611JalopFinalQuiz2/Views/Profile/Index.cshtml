@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var saved = ViewData["SavedProfile"] as ProfileViewModel ?? Model;
    var fullName = string.Join(" ", new[] { saved.FirstName, saved.MiddleName, saved.LastName }.Where(part => !string.IsNullOrWhiteSpace(part)));
    var identity = new AccountMenuViewModel(string.IsNullOrWhiteSpace(fullName) ? Model.Username ?? "Your account" : fullName, Model.Username ?? "", Model.ProfileImg);
    var passwordTab = ViewData["PasswordTab"] is true;
    var recoveredDetails = Context.Request.Method == "POST" && !passwordTab;
}
<section class="profile-page" aria-labelledby="profile-title" data-profile-page>
    <header class="profile-heading">
        <h1 id="profile-title">My profile</h1>
        <a class="button button-secondary profile-back-link" asp-controller="Home" asp-action="Index">Back to university</a>
    </header>
    @if (TempData["StatusMessage"] is string message) { <p class="status-message" role="status">@message</p> }
    <div class="profile-layout">
        <aside class="profile-identity field" aria-label="Profile photo and identity">
            <div class="profile-photo-stack">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImg) && SafeImageAttribute.IsSafeImage(Model.ProfileImg))
                { <img class="profile-photo" src="@Model.ProfileImg" alt="Your current profile photo" data-profile-current /> }
                else { <span class="profile-initial" aria-hidden="true" data-profile-current>@identity.Initials</span> }
                <img class="profile-photo" alt="Selected profile photo preview" hidden data-upload-preview />
            </div>
            <div class="profile-identity-copy">
                <div class="profile-name"><h2>@identity.DisplayName</h2>@if (User.IsInRole("Admin")) { <partial name="_AdminBadge" /> }</div>
                <p>@Model.Username</p>
            </div>
            <div class="profile-photo-controls">
                <label asp-for="ImageUpload" data-profile-photo-label>Profile photo</label>
                <input asp-for="ImageUpload" form="profile-details-form" class="profile-photo-input" type="file" accept="image/png,image/jpeg,image/webp" data-image-upload />
                <button class="button button-secondary" type="button" data-profile-choose hidden>Change photo</button>
            </div>
            <span asp-validation-for="ImageUpload" class="field-error"></span>
        </aside>
        <div class="profile-editors">
            <nav class="profile-tabs" role="tablist" aria-label="Profile settings">
                <a id="profile-details-tab" asp-action="Index" role="tab" aria-controls="profile-details-panel" aria-selected="@(!passwordTab ? "true" : "false")" tabindex="@(passwordTab ? "-1" : "0")" data-profile-tab="details">Personal details</a>
                <a id="profile-password-tab" asp-action="Index" asp-route-tab="password" role="tab" aria-controls="profile-password-panel" aria-selected="@(passwordTab ? "true" : "false")" tabindex="@(passwordTab ? "0" : "-1")" data-profile-tab="password">Change password</a>
            </nav>
            <div id="profile-details-panel" role="tabpanel" aria-labelledby="profile-details-tab" hidden="@passwordTab">
                <form id="profile-details-form" asp-action="Index" method="post" enctype="multipart/form-data" class="profile-form" data-profile-editor data-recovered="@(recoveredDetails ? "true" : "false")">
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    <div class="form-grid">
                        <div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" autocomplete="given-name" maxlength="100" aria-required="true" data-profile-saved="@(saved.FirstName ?? "")" /><span asp-validation-for="FirstName" class="field-error"></span></div>
                        <div class="field"><label asp-for="MiddleName"></label><input asp-for="MiddleName" autocomplete="additional-name" maxlength="100" data-profile-saved="@(saved.MiddleName ?? "")" /><span asp-validation-for="MiddleName" class="field-error"></span></div>
                        <div class="field"><label asp-for="LastName"></label><input asp-for="LastName" autocomplete="family-name" maxlength="100" aria-required="true" data-profile-saved="@(saved.LastName ?? "")" /><span asp-validation-for="LastName" class="field-error"></span></div>
                        <div class="field"><label asp-for="Birthday"></label><input asp-for="Birthday" type="date" autocomplete="bday" data-profile-saved="@(saved.Birthday?.ToString("yyyy-MM-dd") ?? "")" /><span asp-validation-for="Birthday" class="field-error"></span></div>
                    </div>
                    <div class="profile-actions"><a class="button button-secondary" asp-action="Index" data-profile-cancel>Cancel</a><button class="button button-primary" type="submit" disabled="@(ViewData["Unavailable"] is true)">Save changes</button></div>
                </form>
            </div>
            <div id="profile-password-panel" role="tabpanel" aria-labelledby="profile-password-tab" hidden="@(!passwordTab)">
                <form asp-action="ChangePassword" method="post" class="profile-form" data-profile-password>
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    @foreach (var field in new[] { "CurrentPassword", "NewPassword", "ConfirmPassword" })
                    {
                        var label = field == "CurrentPassword" ? "Current password" : field == "NewPassword" ? "New password" : "Confirm password";
                        var fieldName = "Password." + field;
                        var inputId = "Password_" + field;
                        <div class="field">
                            <label for="@inputId">@label</label>
                            <div class="password-control">
                                <input id="@inputId" name="@fieldName" type="password" autocomplete="@(field == "CurrentPassword" ? "current-password" : "new-password")" maxlength="128" aria-required="true" required />
                                <partial name="_PasswordToggle" model="inputId" />
                            </div>
                            @Html.ValidationMessage(fieldName, null, new { @class = "field-error" })
                        </div>
                    }
                    <div class="profile-actions"><a class="button button-secondary" asp-action="Index" asp-route-tab="password" data-profile-cancel>Cancel</a><button class="button button-primary" type="submit" disabled="@(ViewData["Unavailable"] is true)">Update password</button></div>
                </form>
            </div>
        </div>
    </div>
    <dialog class="profile-unsaved-dialog" data-profile-unsaved aria-labelledby="profile-unsaved-title" aria-describedby="profile-unsaved-description">
        <h2 id="profile-unsaved-title">Leave without saving?</h2>
        <p id="profile-unsaved-description">Your changes have not been saved.</p>
        <div class="row-actions"><button class="button button-primary" type="button" data-profile-keep>Keep editing</button><button class="button button-secondary" type="button" data-profile-discard>Discard changes</button></div>
    </dialog>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
    <script src="~/js/profile-editor.js" asp-append-version="true"></script>
}
