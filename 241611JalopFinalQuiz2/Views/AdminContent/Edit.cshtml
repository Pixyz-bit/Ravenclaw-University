@model ContentEditorViewModel
@{
    ViewData["Title"]=(Model.Id==0 ? "Add " : "Edit ")+ContentSections.Label(Model.Section);
    var hasTitle=Model.Section is ContentSection.Values or ContentSection.Programs or ContentSection.Founders or ContentSection.SocialLinks;
    var hasImage=Model.Section is ContentSection.University or ContentSection.Photos or ContentSection.Programs;
}
<section class="editor-panel">
    <a asp-action="Index" asp-route-section="@Model.Section">← @ContentSections.Label(Model.Section)</a>
    <p class="eyebrow">Administration</p><h1>@ViewData["Title"]</h1>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" /><input asp-for="Section" type="hidden" />
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        @if (hasTitle)
        {
            <div class="field"><label asp-for="Title">@(Model.Section==ContentSection.Founders ? "Founder name" : Model.Section==ContentSection.SocialLinks ? "Platform name" : "Title") *</label><input asp-for="Title" maxlength="150" aria-required="true" /><span asp-validation-for="Title" class="field-error"></span></div>
        }
        @if (Model.Section is ContentSection.University or ContentSection.Programs or ContentSection.Founders)
        {
            <div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
        }
        @if (hasImage)
        {
            <div class="field">
                <label asp-for="ImagePath"></label><input asp-for="ImagePath" maxlength="500" list="available-images" aria-describedby="image-help" />
                <datalist id="available-images"><option value="/images/branding/ravenclaw-university-crest.png">Approved university crest</option></datalist>
                <small id="image-help">Choose a preselected image path under /images/ or an HTTPS image URL. Uploading files is not required.</small>
                <span asp-validation-for="ImagePath" class="field-error"></span>
            </div>
        }
        @if (Model.Section==ContentSection.Photos)
        {
            <div class="field"><label asp-for="AltText"></label><input asp-for="AltText" maxlength="250" /><small>Describe what the image shows for screen-reader users.</small><span asp-validation-for="AltText" class="field-error"></span></div>
        }
        @if (Model.Section==ContentSection.University)
        {
            <div class="form-grid">
                <div class="field"><label asp-for="Mission"></label><textarea asp-for="Mission" rows="4"></textarea></div>
                <div class="field"><label asp-for="Vision"></label><textarea asp-for="Vision" rows="4"></textarea></div>
            </div>
        }
        @if (Model.Section==ContentSection.Contacts)
        {
            <div class="field"><label asp-for="Address"></label><textarea asp-for="Address" rows="3" maxlength="500"></textarea><span asp-validation-for="Address" class="field-error"></span></div>
            <div class="form-grid">
                <div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" maxlength="254" /><span asp-validation-for="Email" class="field-error"></span></div>
                <div class="field"><label asp-for="Telephone"></label><input asp-for="Telephone" type="tel" maxlength="50" /><span asp-validation-for="Telephone" class="field-error"></span></div>
            </div>
            <div class="field"><label asp-for="OfficeHours"></label><textarea asp-for="OfficeHours" rows="3" maxlength="300"></textarea><span asp-validation-for="OfficeHours" class="field-error"></span></div>
        }
        @if (Model.Section==ContentSection.Founders)
        {
            <div class="field"><label asp-for="Birthday">Birthday (optional)</label><input asp-for="Birthday" type="date" /><span asp-validation-for="Birthday" class="field-error"></span></div>
            <div class="field"><label asp-for="Message"></label><textarea asp-for="Message" rows="5"></textarea></div>
        }
        @if (Model.Section==ContentSection.SocialLinks)
        {
            <div class="field"><label asp-for="Url"></label><input asp-for="Url" type="url" maxlength="500" /><span asp-validation-for="Url" class="field-error"></span></div>
            <div class="field"><label asp-for="IconClass"></label><select asp-for="IconClass">@foreach (var icon in ContentSections.Icons) { <option value="@icon.Key">@icon.Value</option> }</select><span asp-validation-for="IconClass" class="field-error"></span></div>
        }
        <div class="row-actions"><button class="button button-primary" type="submit">Save changes</button><a class="button button-secondary" asp-action="Index" asp-route-section="@Model.Section">Cancel</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
