@model ContentListViewModel
@{ ViewData["Title"]=ContentSections.Label(Model.Section); }
<div class="editor-heading">
    <div><a asp-controller="Admin" asp-action="Index">← Administration</a><p class="eyebrow">Content management</p><h1>@ViewData["Title"]</h1></div>
    @if (!Model.Unavailable && Model.CanAdd) { <a class="button button-primary" asp-action="Edit" asp-route-section="@Model.Section">Add content</a> }
</div>
@if (TempData["StatusMessage"] is string message) { <div class="status-message" role="status">@message</div> }
@if (Model.Unavailable)
{
    <div class="empty-state" role="alert"><h2>Content is temporarily unavailable.</h2><p>Please check your database connection and try again.</p><a asp-action="Index" asp-route-section="@Model.Section">Try again</a></div>
}
else if (Model.Items.Count==0)
{
    <div class="empty-state"><h2>Nothing here yet.</h2><p>Add the first entry to display it on the university page.</p></div>
}
else
{
    @if (ContentSections.IsSingleton(Model.Section)) { <p class="muted">This section uses one record. Edit its content below.</p> }
    <div class="content-list">
        @foreach (var item in Model.Items)
        {
            <article class="content-row">
                <div><h2>@item.Title</h2><p class="muted">Record @item.Id</p></div>
                <div class="row-actions">
                    <a class="button button-secondary" asp-action="Edit" asp-route-section="@Model.Section" asp-route-id="@item.Id">Edit</a>
                    @if (!ContentSections.IsSingleton(Model.Section)) { <a class="button button-secondary" asp-action="Delete" asp-route-section="@Model.Section" asp-route-id="@item.Id">Delete</a> }
                </div>
            </article>
        }
    </div>
}
