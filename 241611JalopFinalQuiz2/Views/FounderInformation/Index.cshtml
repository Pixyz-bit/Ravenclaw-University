@model FounderInformationViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Founder";
}
<section class="editor-panel">
    <h1>Founder</h1>
    @if (TempData["StatusMessage"] is string message) { <div class="status-message" role="status">@message</div> }
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    @if (Model.Id > 0)
    {
        <div class="admin-editor-grid admin-editor-grid--single">
            <div class="admin-editor-fields">
                <form asp-action="Index" asp-route-id="" asp-route-confirmDelete="" method="post" data-admin-editor data-recovered="@(Context.Request.Method == "POST" ? "true" : "false")">
                    <input asp-for="Id" type="hidden" />
                    <fieldset class="editor-fieldset editor-fieldset--quiet"><legend>Founder details</legend>
                        <div class="field"><label asp-for="FounderName"></label><input asp-for="FounderName" maxlength="150" /><span asp-validation-for="FounderName" class="field-error"></span></div>
                        </fieldset>
                    <fieldset class="editor-fieldset"><legend>Biography and message</legend>
                        <div class="form-grid">
                            <div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="8"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
                            <div class="field"><label asp-for="FounderMessage"></label><textarea asp-for="FounderMessage" rows="8"></textarea><span asp-validation-for="FounderMessage" class="field-error"></span></div>
                        </div>
                    </fieldset>
                    <div class="row-actions">
                        <button class="button button-primary" type="submit" disabled="@(ViewData["Unavailable"] is true)">Save changes</button>
                        <a class="button button-secondary" asp-action="Index" asp-route-id="" asp-route-confirmDelete="">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (ViewData["Unavailable"] is not true)
    { <p class="empty-copy">Founder information has not been set up. This page only edits the existing founder.</p> }
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
