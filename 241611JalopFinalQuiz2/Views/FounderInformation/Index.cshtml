@model FounderInformationViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Founder";
    var preview = new AdminPreviewViewModel("Founder content preview", new[] { new AdminPreviewField("FounderName", "Founder Name", Model.FounderName), new AdminPreviewField("Description", "Founder Info", Model.Description), new AdminPreviewField("FounderMessage", "Founder Message", Model.FounderMessage) });
}
<section class="editor-panel">
    <h1>Founder</h1>
    @if (TempData["StatusMessage"] is string message) { <div class="status-message" role="status">@message</div> }
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    @if (Model.ConfirmDelete)
    {
        <h2>Delete this entry?</h2>
        <p>@Model.FounderName</p>
        <p>This removes the entry from the university page.</p>
        <form asp-action="Delete" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="row-actions"><button class="button button-danger" type="submit">Delete entry</button><a class="button button-secondary" asp-action="Index" asp-route-id="" asp-route-confirmDelete="">Cancel</a></div>
        </form>
    }
    else
    {
        <div class="admin-editor-grid">
            <div class="admin-editor-fields">
                <h2>@(Model.Id == 0 ? "Add entry" : "Edit entry")</h2>
                <form asp-action="Index" asp-route-id="" asp-route-confirmDelete="" method="post" data-admin-editor data-recovered="@(Context.Request.Method == "POST" ? "true" : "false")">
                    <input asp-for="Id" type="hidden" />
                    <fieldset class="editor-fieldset"><legend>Founder details</legend>
                        <div class="field"><label asp-for="FounderName"></label><input asp-for="FounderName" maxlength="150" /><span asp-validation-for="FounderName" class="field-error"></span></div>
                        </fieldset>
                    <fieldset class="editor-fieldset"><legend>Biography and message</legend>
                        <div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
                        <div class="field"><label asp-for="FounderMessage"></label><textarea asp-for="FounderMessage" rows="4"></textarea><span asp-validation-for="FounderMessage" class="field-error"></span></div>
                    </fieldset>
                    <div class="row-actions">
                        <button class="button button-primary" type="submit" disabled="@(ViewData["Unavailable"] is true)">Save changes</button>
                        <a class="button button-secondary" asp-action="Index" asp-route-id="" asp-route-confirmDelete="">Cancel</a>
                    </div>
                </form>
            </div>
            <partial name="_AdminContentPreview" model="preview" />
        </div>
    }
    @if (ViewData["Unavailable"] is not true)
    {
        <div class="admin-section-heading saved-entries-heading"><h2>Saved entries</h2><span class="admin-count">@Model.Items.Count</span></div>
        @if (Model.Items.Count == 0) { <p class="empty-copy">No entries yet. Use the form above to add the first one.</p> }
        <div class="content-list">
            @foreach (var item in Model.Items)
            {
                <article class="content-row">
                    <div><h3>@item.FounderName</h3><p class="content-excerpt">@(string.IsNullOrWhiteSpace(item.Description) ? "No biography yet" : item.Description)</p></div>
                    <div class="row-actions">
                        <a class="button button-secondary" asp-action="Index" asp-route-id="@item.FounderId">Edit</a>
                        <a class="button button-delete" asp-action="Index" asp-route-id="@item.FounderId" asp-route-confirmDelete="true">Delete</a>
                    </div>
                </article>
            }
        </div>
    }
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
