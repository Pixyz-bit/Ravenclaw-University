@model UniversityPageViewModel
@{ ViewData["Title"]="University"; ViewData["MainClass"] = Model.Unavailable ? null : "university-main"; }
@if (Model.Unavailable)
{
    <section class="empty-state" role="alert"><h1>University information is temporarily unavailable.</h1><p>Please try again in a moment.</p><a class="button button-primary" asp-action="Index">Try again</a></section>
}
else
{
    <section id="home" class="university-hero" aria-labelledby="hero-header" data-viewport-hero>
        <img class="hero-background" src="~/images/hero/ravenclaw-common-room.png" asp-append-version="true" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
        <div class="hero-copy">
            <p class="eyebrow">Ravenclaw University</p>
            <h1 id="hero-header" class="hero-header">Where Wisdom<br /><em>Takes Flight.</em></h1>
            <p class="hero-description">A place for curious minds. Explore our university and its academic programs.</p>
        </div>
    </section>
    <partial name="_UniversityAbout" model="Model" />
    <section id="academics" class="academics-showcase" aria-labelledby="academics-title">
        <div class="academics-heading">
            <div><p class="eyebrow">Academics</p><h2 id="academics-title" class="university-section-title">Find your field of discovery.</h2></div>
        </div>
        @if (Model.Programs.Count == 0)
        {
            <p class="academics-empty">Academic programs have not been published yet. Please check back soon.</p>
        }
        else
        {
            <p class="sr-only" id="programs-help">Scroll to explore. Select a program to read its description.</p>
            <div class="program-viewport">
            <div class="program-rail" tabindex="0" role="region" aria-label="Academic programs" aria-describedby="programs-help">
                @foreach (var program in Model.Programs)
                {
                    <details class="program-card">
                        <summary>
                            @if (!string.IsNullOrWhiteSpace(program.ImagePath) && SafeImageAttribute.IsSafeImage(program.ImagePath))
                            {
                                <img class="program-card-image" src="@program.ImagePath" alt="" loading="lazy" decoding="async" data-content-image />
                                <span class="program-image-placeholder" data-image-fallback hidden>Program image unavailable</span>
                            }
                            else { <span class="program-image-placeholder">Program image not yet published</span> }
                            <span class="program-card-caption">
                                <span class="program-card-title">@program.SubjectName</span>
                                <span class="program-card-copy prose" tabindex="0">@(string.IsNullOrWhiteSpace(program.Description) ? "A description has not been published yet." : program.Description)</span>
                            </span>
                        </summary>
                    </details>
                }
            </div>
            </div>
        }
    </section>
    @* Temporarily hidden at the user's request; retain the sections for restoration.
    <partial name="_UniversityGallery" model="Model" />
    <partial name="_CollegiateCircle" />
    *@
    <partial name="_UniversityFounders" model="Model" />
}
@section Footer {
    @if (!Model.Unavailable) { <partial name="_UniversityContact" model="Model" /> }
    else { <footer class="portal-footer">© @DateTime.UtcNow.Year Ravenclaw University <span>Where Wisdom Takes Flight.</span></footer> }
}
@section Scripts {
    <script src="~/js/hero-layout.js" asp-append-version="true"></script>
    <script src="~/js/program-showcase.js" asp-append-version="true"></script>
    <script src="~/js/about-story.js" asp-append-version="true"></script>
    @* Restore alongside the gallery and Collegiate Circle sections.
    <script src="~/js/drift-wall.js" asp-append-version="true"></script>
    <script src="~/js/collegiate-circle.js" asp-append-version="true"></script>
    *@
}
