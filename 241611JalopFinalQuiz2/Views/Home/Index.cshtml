@model UniversityPageViewModel
@{ ViewData["Title"]="University"; ViewData["MainClass"] = Model.Unavailable ? null : "university-main"; }
@if (Model.Unavailable)
{
    <section class="empty-state" role="alert"><h1>University information is temporarily unavailable.</h1><p>Please try again in a moment.</p><a class="button button-primary" asp-action="Index">Try again</a></section>
}
else
{
    var heroImages = new List<(string Path, string Name)>
    {
        ("/images/hero/ravenclaw-common-room.png", "Ravenclaw common room"),
        ("/images/hero/portrait-stairwell.png", "Portrait stairwell"),
        ("/images/hero/great-hall.png", "Great Hall"),
        ("/images/hero/ravenclaw-eagle-wall.png", "Ravenclaw eagle wall")
    };
    if (!string.IsNullOrWhiteSpace(Model.University?.HeroImg) && SafeImageAttribute.IsSafeImage(Model.University.HeroImg)
        && Model.University.HeroImg != "/images/branding/ravenclaw-university-crest.png")
        heroImages.Add((Model.University.HeroImg, "University image"));
    <section id="home" class="university-hero" aria-labelledby="hero-header" data-hero-gallery>
        @for (var i = 0; i < heroImages.Count; i++)
        {
            <img id="hero-slide-@i" class="hero-background hero-slide @(i == 0 ? "is-current" : "")" src="@(i == 0 ? Url.Content(heroImages[i].Path) : null)" data-src="@Url.Content(heroImages[i].Path)" alt="" aria-hidden="true" decoding="async" fetchpriority="@(i == 0 ? "high" : "low")" />
        }
        <div class="hero-copy">
            <p class="eyebrow">Ravenclaw University</p>
            <h1 id="hero-header" class="hero-header">Where Wisdom<br /><em>Takes Flight.</em></h1>
            <p class="hero-description">A place for curious minds. Explore our university and its academic programs.</p>
        </div>
        <div class="hero-controls" role="group" aria-label="Hero background images" hidden>
            @for (var i = 0; i < heroImages.Count; i++)
            {
                <button type="button" class="hero-image-button" data-slide="@i" aria-controls="hero-slide-@i" aria-pressed="@(i == 0 ? "true" : "false")" aria-label="Show @heroImages[i].Name"><span aria-hidden="true"></span></button>
            }
            <span class="sr-only" role="status" data-hero-status></span>
        </div>
    </section>
    <div class="university-content">
    @if (User.IsInRole("Admin")) { <p class="admin-note">You are viewing the student-facing page. <a asp-controller="Admin" asp-action="Index">Manage university content →</a></p> }
    <section id="about" class="university-section">
        <div class="section-heading"><p class="eyebrow">About the university</p><h2>Knowledge begins with curiosity.</h2></div>
        @if (!string.IsNullOrWhiteSpace(Model.University?.AcademyDescription)) { <p class="prose">@Model.University.AcademyDescription</p> }
        else { <p class="empty-copy">University information will be published here.</p> }
        <div class="mission-grid">
            <div><h3>Our mission</h3><p class="prose">@(Model.University?.Mission ?? "Our mission statement will be published here.")</p></div>
            <div><h3>Our vision</h3><p class="prose">@(Model.University?.Vision ?? "Our vision statement will be published here.")</p></div>
        </div>
        <h3>Our core values</h3>
        @if (Model.Values.Count>0) { <ul class="values-list">@foreach (var value in Model.Values) { <li>@value.Title</li> }</ul> }
        else { <p class="empty-copy">Core values have not been published yet.</p> }
        @if (Model.Photos.Count>0)
        {
            <div class="gallery-grid">
                @foreach (var photo in Model.Photos)
                {
                    <figure><div class="image-frame">
                        @if (SafeImageAttribute.IsSafeImage(photo.ImagePath)) { <img src="@photo.ImagePath" alt="@(photo.AltText ?? "University gallery image")" loading="lazy" data-content-image /><span class="media-fallback" data-image-fallback hidden>Image unavailable</span> }
                        else { <span class="media-fallback">Image unavailable</span> }
                    </div>@if (!string.IsNullOrWhiteSpace(photo.AltText)) { <figcaption>@photo.AltText</figcaption> }</figure>
                }
            </div>
        }
    </section>
    <section id="academics" class="university-section academics-section">
        <div class="section-heading"><p class="eyebrow">Academics</p><h2>Find your field of discovery.</h2></div>
        @if (Model.Programs.Count==0) { <p class="empty-copy">Academic programs have not been published yet. Please check back soon.</p> }
        else
        {
            <div class="program-grid">
                @foreach (var program in Model.Programs)
                {
                    <article class="program-entry">
                        @if (!string.IsNullOrWhiteSpace(program.ImagePath))
                        {
                            <div class="image-frame">
                                @if (SafeImageAttribute.IsSafeImage(program.ImagePath)) { <img src="@program.ImagePath" alt="@program.SubjectName" loading="lazy" data-content-image /><span class="media-fallback" data-image-fallback hidden>Program image unavailable</span> }
                                else { <span class="media-fallback">Program image unavailable</span> }
                            </div>
                        }
                        <h3>@program.SubjectName</h3><p class="prose">@program.Description</p>
                    </article>
                }
            </div>
        }
    </section>
    <section id="contact" class="university-section">
        <div class="section-heading"><p class="eyebrow">Contact</p><h2>Start a conversation.</h2></div>
        @if (Model.Contact is null) { <p class="empty-copy">Contact details have not been published yet.</p> }
        else
        {
            <dl class="contact-grid">
                <div><dt>University address</dt><dd class="prose">@(Model.Contact.AcademyAddress ?? "Not published yet")</dd></div>
                <div><dt>Email</dt><dd>@if (!string.IsNullOrWhiteSpace(Model.Contact.Email)) { <a href="mailto:@Model.Contact.Email">@Model.Contact.Email</a> } else { <span>Not published yet</span> }</dd></div>
                <div><dt>Telephone</dt><dd>@if (!string.IsNullOrWhiteSpace(Model.Contact.Telephone)) { <a href="tel:@Model.Contact.Telephone">@Model.Contact.Telephone</a> } else { <span>Not published yet</span> }</dd></div>
                <div><dt>Office hours</dt><dd class="prose">@(Model.Contact.OfficeHours ?? "Not published yet")</dd></div>
            </dl>
        }
        @if (Model.SocialLinks.Count>0)
        {
            <div class="social-links" aria-label="University social links">
                @foreach (var social in Model.SocialLinks)
                {
                    @if (Uri.TryCreate(social.Url,UriKind.Absolute,out var uri) && uri.Scheme==Uri.UriSchemeHttps)
                    {
                        <a href="@social.Url" target="_blank" rel="noopener noreferrer">@if (!string.IsNullOrWhiteSpace(social.IconClass) && ContentSections.Icons.ContainsKey(social.IconClass)) { <i class="@social.IconClass" aria-hidden="true"></i> } @social.PlatformName <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
                    }
                }
            </div>
        }
    </section>
    <section id="leadership" class="university-section leadership-section">
        <div class="section-heading"><p class="eyebrow">Founder information</p><h2>The vision behind the university.</h2></div>
        @if (Model.Founders.Count==0) { <p class="empty-copy">Founder information will be published here.</p> }
        @foreach (var founder in Model.Founders)
        {
            <article class="founder-entry"><h3>@founder.FounderName</h3>
                @if (founder.Birthday.HasValue) { <p class="founder-date">Born <time datetime="@founder.Birthday.Value.ToString("yyyy-MM-dd")">@founder.Birthday.Value.ToString("MMMM d, yyyy",System.Globalization.CultureInfo.InvariantCulture)</time></p> }
                <p class="prose">@founder.Description</p>
                @if (!string.IsNullOrWhiteSpace(founder.FounderMessage)) { <h4>A message from the founder</h4><blockquote class="prose">@founder.FounderMessage</blockquote> }
            </article>
        }
    </section>
    </div>
}
@section Scripts { <script src="~/js/hero-gallery.js" asp-append-version="true"></script> }
