@model AccountManagementViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Account management"; var preview = new AdminPreviewViewModel("Account preview", new[] { new AdminPreviewField("Username", "Username", Model.Username), new AdminPreviewField("FirstName", "First name", Model.FirstName), new AdminPreviewField("LastName", "Last name", Model.LastName), new AdminPreviewField("MiddleName", "Middle name", Model.MiddleName), new AdminPreviewField("Birthday", "Birthday", Model.Birthday?.ToString("yyyy-MM-dd")), new AdminPreviewField("Role", "Role", Model.Role), new AdminPreviewField("IsActive", "Account access", Model.IsActive ? "Active" : "Inactive") }, Model.ProfileImg, ShowImage: true, Portrait: false); }
<section class="editor-panel">
    <p class="eyebrow">Administration</p>
    <h1>Account management</h1>
    <p class="muted">Find an account, review its information, or manage sign-in access.</p>
    @if (ViewData["Unavailable"] is not true)
    {
        <section class="admin-inventory" aria-labelledby="account-analytics-title">
            <h2 id="account-analytics-title">Account analytics</h2>
            <p class="muted">Active users are accounts enabled to sign in. Totals include all accounts.</p>
            <dl class="admin-metrics account-metrics">
                <div><dt>Total Registered</dt><dd>@Model.TotalAccounts</dd></div>
                <div><dt>Active Users</dt><dd>@Model.ActiveUsers</dd></div>
                <div><dt>Deactivated Users</dt><dd>@Model.DeactivatedUsers</dd></div>
            </dl>
        </section>
    }
    @if (TempData["StatusMessage"] is string message) { <div class="status-message" role="status">@message</div> }
    @if (TempData["AccountError"] is string accountError) { <div class="validation-summary" role="alert">@accountError</div> }
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    @if (Model.Id > 0)
    {
        <div class="admin-editor-grid">
            <div class="admin-editor-fields">
                <h2>Edit account</h2>
                <form asp-action="Index" asp-route-id="" method="post" data-admin-editor data-recovered="@(Context.Request.Method == "POST" ? "true" : "false")" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" /><input asp-for="Search" type="hidden" />
                    <fieldset class="editor-fieldset"><legend>Account details</legend>
                        <div class="field"><label asp-for="Username"></label><input asp-for="Username" maxlength="100" autocomplete="off" /><span asp-validation-for="Username" class="field-error"></span></div>
                        <div class="form-grid">
                            <div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" maxlength="100" /><span asp-validation-for="FirstName" class="field-error"></span></div>
                            <div class="field"><label asp-for="LastName"></label><input asp-for="LastName" maxlength="100" /><span asp-validation-for="LastName" class="field-error"></span></div>
                            <div class="field"><label asp-for="MiddleName"></label><input asp-for="MiddleName" maxlength="100" /><span asp-validation-for="MiddleName" class="field-error"></span></div>
                            <div class="field"><label asp-for="Birthday"></label><input asp-for="Birthday" type="date" /><span asp-validation-for="Birthday" class="field-error"></span></div>
                            <div class="field"><label asp-for="Role"></label><select asp-for="Role"><option>Student</option><option>Admin</option></select><span asp-validation-for="Role" class="field-error"></span></div>
                        </div>
                        </fieldset>
                    <fieldset class="editor-fieldset"><legend>Account access and image</legend>
                        <div class="field"><label class="checkbox-label"><input asp-for="IsActive" /> Active account</label><small>Inactive accounts cannot sign in. Your own account must remain an active Admin.</small></div>
                        <div class="field">
                            <label asp-for="ImageUpload"></label><input asp-for="ImageUpload" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="profile-help" data-image-upload />
                            <small id="profile-help">PNG, JPEG, or WebP, up to 5 MB. Leave empty to keep the current image.</small>
                            <span asp-validation-for="ImageUpload" class="field-error"></span>
                            @if (!string.IsNullOrWhiteSpace(Model.ProfileImg) && SafeImageAttribute.IsSafeImage(Model.ProfileImg)) { <img class="upload-preview" src="@Model.ProfileImg" alt="Current profile image" /> }
                            <img class="upload-preview" alt="Selected profile image preview" hidden data-upload-preview />
                        </div>
                    </fieldset>
                    <div class="row-actions"><button class="button button-primary" type="submit" disabled="@(ViewData["Unavailable"] is true)">Save account</button><a class="button button-secondary" asp-action="Index" asp-route-id="">Cancel</a></div>
                </form>
            </div>
            <partial name="_AdminContentPreview" model="preview" />
        </div>
    }
    <h2 class="saved-entries-heading">Accounts</h2>
    <form asp-action="Index" asp-route-id="" method="get" class="account-search">
        <div class="field"><label asp-for="Search">Search by username or name</label><input asp-for="Search" maxlength="100" /></div><button class="button button-secondary" type="submit">Search</button>
    </form>
    <p class="muted">Showing up to 100 accounts. Refine the search to find a specific account.</p>
    @if (Model.Items.Count == 0 && ViewData["Unavailable"] is not true) { <p>No matching accounts.</p> }
    <div class="account-directory">
        <div class="account-directory-head" aria-hidden="true"><span>Account</span><span>Role</span><span>Status</span><span>Actions</span></div>
        @foreach (var account in Model.Items)
        {
            var fullName = string.Join(" ", new[] { account.FirstName, account.LastName }.Where(part => !string.IsNullOrWhiteSpace(part)));
            var displayName = string.IsNullOrWhiteSpace(fullName) ? account.Username : fullName;
            var initials = string.Concat((displayName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[..1])).ToUpperInvariant();
            var ownAccount = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == account.Id.ToString();
            <article class="account-directory-row" aria-label="@displayName">
                <div class="account-identity">
                    @if (!string.IsNullOrWhiteSpace(account.ProfileImg) && SafeImageAttribute.IsSafeImage(account.ProfileImg))
                    { <img class="account-avatar" src="@account.ProfileImg" alt="" loading="lazy" /> }
                    else { <span class="account-avatar account-initials" aria-hidden="true">@initials</span> }
                    <div><h3>@displayName</h3><p>@account.Username</p></div>
                </div>
                <span class="account-role">@account.Role</span>
                <span class="account-status @(account.IsActive ? "is-active" : "is-deactivated")"><span aria-hidden="true"></span>@(account.IsActive ? "Active" : "Deactivated")</span>
                <div class="account-directory-actions">
                    @if (ownAccount) { <span class="account-self-label">Your account</span> }
                    else
                    {
                    <form asp-action="SetActive" method="post">
                        <input type="hidden" name="id" value="@account.Id" /><input type="hidden" name="isActive" value="@(!account.IsActive ? "true" : "false")" /><input type="hidden" name="search" value="@Model.Search" />
                        <button type="submit" class="button @(account.IsActive ? "account-deactivate" : "account-activate")" disabled="@ownAccount" aria-label="@(account.IsActive ? "Deactivate" : "Activate") @displayName" title="@(ownAccount ? "Your account must remain active." : null)">@(account.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                    }
                    <a class="button button-primary" asp-action="Details" asp-route-id="@account.Id" asp-route-search="@Model.Search" aria-label="View information for @displayName">View information</a>
                </div>
            </article>
        }
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
