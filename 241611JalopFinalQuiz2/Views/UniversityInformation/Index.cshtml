@model UniversityInformationViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "University information";
}
<section class="editor-panel">
    <p class="eyebrow">University content</p>
    <h1>University information</h1>
    <p class="muted">Update the introduction, mission, vision, and main image students see on the university page.</p>
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="status-message" role="status">@message</div>
    }
    <form asp-controller="UniversityInformation" asp-action="Index" asp-route-id="" asp-route-confirmDelete="" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
            <div class="field">
                <label asp-for="ImageUpload"></label>
                <input asp-for="ImageUpload" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="image-help" data-image-upload />
                <small id="image-help">PNG, JPEG, or WebP, up to 5 MB. Leave empty to keep the current image.</small>
                <span asp-validation-for="ImageUpload" class="field-error"></span>
                @if (!string.IsNullOrWhiteSpace(Model.HeroImg) && SafeImageAttribute.IsSafeImage(Model.HeroImg)) { <img class="upload-preview" src="@Model.HeroImg" alt="Current hero image" /> }
                <img class="upload-preview" alt="Selected image preview" hidden data-upload-preview />
            </div>
        <div class="field">
            <label asp-for="AcademyDescription"></label>
            <textarea asp-for="AcademyDescription" rows="5"></textarea>
            <span asp-validation-for="AcademyDescription" class="field-error"></span>
        </div>
        <div class="form-grid">
            <div class="field"><label asp-for="Mission"></label><textarea asp-for="Mission" rows="5"></textarea><span asp-validation-for="Mission" class="field-error"></span></div>
            <div class="field"><label asp-for="Vision"></label><textarea asp-for="Vision" rows="5"></textarea><span asp-validation-for="Vision" class="field-error"></span></div>
        </div>
        <div class="row-actions">
            <button class="button button-primary" type="submit" disabled="@(ViewData["Unavailable"] is true)">Save changes</button>
            <a class="button button-secondary" asp-controller="Home" asp-action="Index">View university</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
