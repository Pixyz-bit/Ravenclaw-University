@model UniversityInformationViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hero and About";
    var preview = new AdminPreviewViewModel("Hero and About preview", new[] { new AdminPreviewField("AboutHeading", "About Heading", Model.AboutHeading), new AdminPreviewField("AcademyDescription", "About Description", Model.AcademyDescription), new AdminPreviewField("Mission", "Mission", Model.Mission), new AdminPreviewField("Vision", "Vision", Model.Vision), new AdminPreviewField("CoreValuesText", "Core Values", Model.CoreValuesText, IsList: true) }, Model.HeroImg, ShowImage: true, Portrait: false);
}
<section class="editor-panel">
    <h1>Hero and About</h1>
    <p class="muted">Edit the hero image, introduction, purpose, and values shown on the university page.</p>
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="status-message" role="status">@message</div>
    }
    <div class="admin-editor-grid">
        <div class="admin-editor-fields">
            <h2>Page content</h2>
            <form asp-controller="UniversityInformation" asp-action="Index" asp-route-id="" asp-route-confirmDelete="" method="post" data-admin-editor data-recovered="@(Context.Request.Method == "POST" ? "true" : "false")" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
                <fieldset class="editor-fieldset"><legend>Introduction and purpose</legend>
                    <div class="field">
                        <label asp-for="ImageUpload"></label>
                        <input asp-for="ImageUpload" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="image-help" data-image-upload />
                        <small id="image-help">PNG, JPEG, or WebP, up to 5 MB. Leave empty to keep the current image.</small>
                        <span asp-validation-for="ImageUpload" class="field-error"></span>
                        @if (!string.IsNullOrWhiteSpace(Model.HeroImg) && SafeImageAttribute.IsSafeImage(Model.HeroImg)) { <img class="upload-preview" src="@Model.HeroImg" alt="Current hero image" /> }
                        <img class="upload-preview" alt="Selected image preview" hidden data-upload-preview />
                    </div>
                    <div class="field">
                        <label asp-for="AboutHeading"></label>
                        <input asp-for="AboutHeading" maxlength="150" aria-describedby="heading-help" />
                        <small id="heading-help">Leave empty to use “A place for curious minds.”</small>
                        <span asp-validation-for="AboutHeading" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="AcademyDescription"></label>
                        <textarea asp-for="AcademyDescription" rows="5"></textarea>
                        <span asp-validation-for="AcademyDescription" class="field-error"></span>
                    </div>
                    </fieldset>
                <fieldset class="editor-fieldset"><legend>Mission and vision</legend>
                <div class="form-grid">
                        <div class="field"><label asp-for="Mission"></label><textarea asp-for="Mission" rows="5"></textarea><span asp-validation-for="Mission" class="field-error"></span></div>
                        <div class="field"><label asp-for="Vision"></label><textarea asp-for="Vision" rows="5"></textarea><span asp-validation-for="Vision" class="field-error"></span></div>
                    </div>
                </fieldset>
                <fieldset class="editor-fieldset" id="core-values"><legend>Core Values</legend>
                    <div class="field">
                        <label asp-for="CoreValuesText"></label>
                        <textarea asp-for="CoreValuesText" rows="6" aria-describedby="values-help"></textarea>
                        <small id="values-help">Enter one value per line, up to 100 characters each. Values appear as a bulleted list. Remove a line to remove that value; leave empty to clear the list.</small>
                        <span asp-validation-for="CoreValuesText" class="field-error"></span>
                    </div>
                </fieldset>
                <div class="row-actions">
                    <button class="button button-primary" type="submit" disabled="@(ViewData["Unavailable"] is true)">Save changes</button>
                    <a class="button button-secondary" asp-controller="Home" asp-action="Index">View university</a>
                </div>
            </form>
        </div>
        <partial name="_AdminContentPreview" model="preview" />
    </div>
    <details><summary>About images</summary><p>Manage the images used alongside the About chapters.</p><a class="button button-secondary" asp-controller="AboutGallery" asp-action="Index">Manage About images</a></details>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
