@model AdminDashboardViewModel
@{ ViewData["Title"] = "Administration"; }
<header class="admin-page-heading">
    <div><p class="eyebrow">Administration</p><h1>Welcome, @User.Identity?.Name.</h1><p class="muted">An overview of your saved university content.</p></div>
    <a class="button button-secondary" asp-controller="Home" asp-action="Index">View university <span aria-hidden="true">↗</span></a>
</header>
@if (Model.Unavailable)
{
    <div class="validation-summary" role="alert"><h2>Content overview is temporarily unavailable.</h2><p>Your content has not changed. Try loading the overview again.</p><a class="button button-secondary" asp-action="Index">Try again</a></div>
}
else
{
    <section class="admin-inventory" aria-labelledby="inventory-title">
        <h2 id="inventory-title">Content inventory</h2>
        <dl class="admin-metrics content-metrics">
            <div><dt>Academic programs</dt><dd>@Model.Programs</dd></div>
            <div><dt>Core values</dt><dd>@Model.CoreValues</dd></div>
            <div><dt>Saved gallery images</dt><dd>@Model.GalleryImages</dd></div>
        </dl>
    </section>
}
