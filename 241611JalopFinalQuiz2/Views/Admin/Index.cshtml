@{ ViewData["Title"] = "Administration"; }
<section class="portal-panel editor-panel">
    <p class="eyebrow">Administration</p>
    <h1>Welcome, @User.Identity?.Name.</h1>
    <p>Manage the information students see on the university page.</p>
    <a class="button button-primary" asp-controller="Home" asp-action="Index">View university portal</a>
</section>
<div class="dashboard-list">
    @foreach (var contentSection in Enum.GetValues<ContentSection>())
    {
        <a class="dashboard-link" asp-controller="AdminContent" asp-action="Index" asp-route-section="@contentSection"><span>@ContentSections.Label(contentSection)</span><span aria-hidden="true">→</span></a>
    }
</div>
