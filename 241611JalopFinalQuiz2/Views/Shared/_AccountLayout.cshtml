<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Ravenclaw University</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="account-body">
    <a class="skip-link" href="#main-content">Skip to form</a>
    <div class="account-shell">
        <aside class="account-story" aria-label="Ravenclaw University">
            <a class="wordmark" asp-controller="Account" asp-action="Login"><span class="monogram" aria-hidden="true">RU</span><span>Ravenclaw<br />University</span></a>
            <div class="story-copy">
                <span class="eyebrow">The university portal</span>
                <p class="story-title">Where Wisdom<br /><em>Takes Flight.</em></p>
                <p>A place for curious minds.<br />Your next chapter starts here.</p>
                <div class="story-rule" aria-hidden="true"></div>
                <span class="story-caption">Wisdom · Integrity · Discovery</span>
            </div>
            <p class="story-footer">Ravenclaw University · Student access</p>
        </aside>
        <main id="main-content" class="account-content">@RenderBody()</main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
