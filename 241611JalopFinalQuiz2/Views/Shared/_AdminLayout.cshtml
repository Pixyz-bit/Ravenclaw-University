@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var activeSection = (Model as IAdminSectionViewModel)?.Section;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ravenclaw University</title>
    <link rel="icon" type="image/png" href="~/images/branding/ravenclaw-university-crest.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <a class="skip-link" href="#main-content">Skip to administration content</a>
    <aside class="admin-sidebar">
        <a class="wordmark" asp-controller="UniversityInformation" asp-action="Index" asp-route-id="" asp-route-confirmDelete=""><img class="university-logo" src="~/images/branding/ravenclaw-university-crest.png" asp-append-version="true" width="1123" height="1401" alt="" /><span>Ravenclaw<br />University</span></a>
        <p class="admin-sidebar-label">Administration</p>
        <details class="admin-navigation" open>
            <summary>Navigation</summary>
            <nav aria-label="Administration navigation">
                @foreach (var contentSection in new[] { ContentSection.University, ContentSection.Programs, ContentSection.Founders, ContentSection.Contacts })
                {
                    var active = activeSection == contentSection
                        || (contentSection == ContentSection.University && activeSection is ContentSection.Values or ContentSection.Photos);
                    <a class="admin-nav-link @(active ? "is-active" : "")" aria-current="@(active ? "page" : null)" asp-controller="@ContentSections.ControllerName(contentSection)" asp-action="Index" asp-route-id="" asp-route-confirmDelete="">@ContentSections.Label(contentSection)</a>
                }
                <a class="admin-nav-link @(controller == "AccountManagement" ? "is-active" : "")" aria-current="@(controller == "AccountManagement" ? "page" : null)" asp-controller="AccountManagement" asp-action="Index" asp-route-id="" asp-route-confirmDelete="">Account Management</a>
            </nav>
        </details>
        <div class="admin-sidebar-bottom">
            <a class="admin-site-link" asp-controller="Profile" asp-action="Index">Edit personal information <span aria-hidden="true">↗</span></a>
            <a class="admin-site-link" asp-controller="Home" asp-action="Index" asp-route-id="" asp-route-confirmDelete="">View university <span aria-hidden="true">↗</span></a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="button button-outline" type="submit">Sign out</button></form>
        </div>
    </aside>
    <div class="admin-workspace">
        <main id="main-content" class="admin-main">@RenderBody()</main>
        <footer class="admin-footer">© @DateTime.UtcNow.Year Ravenclaw University · Administration</footer>
    </div>
    <dialog class="admin-unsaved-dialog" data-admin-unsaved aria-labelledby="unsaved-title" aria-describedby="unsaved-description">
        <h2 id="unsaved-title">Leave without saving?</h2>
        <p id="unsaved-description">Your draft has unsaved changes. Keep editing to save them, or discard the draft and continue.</p>
        <div class="row-actions"><button class="button button-primary" type="button" data-keep-editing>Keep editing</button><button class="button button-secondary" type="button" data-discard-draft>Discard changes</button></div>
    </dialog>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/admin-navigation.js" asp-append-version="true"></script>
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
    <script src="~/js/admin-editor.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
