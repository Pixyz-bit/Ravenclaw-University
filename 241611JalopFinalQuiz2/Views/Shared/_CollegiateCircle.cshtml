@{
    var banners = new[]
    {
        (Key: "gryffindor", Name: "Gryffindor", Description: "Crimson and gold pennant with an illustrated lion crest"),
        (Key: "slytherin", Name: "Slytherin", Description: "Emerald and silver pennant with an illustrated serpent crest"),
        (Key: "hogwarts", Name: "Hogwarts", Description: "Navy and gold pennant with a quartered shield and original H monogram"),
        (Key: "ravenclaw", Name: "Ravenclaw", Description: "Royal blue and silver pennant with an illustrated eagle crest"),
        (Key: "hufflepuff", Name: "Hufflepuff", Description: "Ochre and black pennant with an illustrated badger crest")
    };
}
<section id="collegiate-circle" class="collegiate-section" aria-labelledby="collegiate-title">
    <header class="collegiate-heading">
        <p class="eyebrow">The Hogwarts Collegiate Circle</p>
        <h2 id="collegiate-title">One legacy. Four distinct houses.</h2>
        <p>Gryffindor, Slytherin, Ravenclaw, and Hufflepuff, united beneath the Hogwarts crest.</p>
    </header>
    <p class="collegiate-hint" id="collegiate-help">Swipe or use the arrow keys to explore all five banners.</p>
    <div class="collegiate-scroll" tabindex="0" role="region" aria-label="Hogwarts and the four house banners" aria-describedby="collegiate-help" data-collegiate-scroll>
        <div class="collegiate-stage">
            <svg class="collegiate-rope" aria-hidden="true" viewBox="0 0 1200 100" preserveAspectRatio="none"><path d="M0 12 Q600 92 1200 12" /></svg>
            <div class="collegiate-banners">
                @foreach (var banner in banners)
                {
                    <figure class="collegiate-banner @(banner.Key == "hogwarts" ? "is-central" : "")">
                        <div class="collegiate-pennant" data-collegiate-pennant>
                            <img src="~/images/collegiate/@(banner.Key).png" asp-append-version="true" width="793" height="1983" alt="@banner.Description" loading="lazy" decoding="async" draggable="false" />
                        </div>
                        <figcaption>@banner.Name</figcaption>
                    </figure>
                }
            </div>
        </div>
    </div>
</section>
