<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ravenclaw University</title>
    <link rel="icon" type="image/png" href="~/images/branding/ravenclaw-university-crest.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="portal-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="portal-header">
      <div class="portal-header-inner">
        <a class="wordmark" asp-controller="Home" asp-action="Index"><img class="university-logo" src="~/images/branding/ravenclaw-university-crest.png" asp-append-version="true" width="1123" height="1401" alt="" aria-hidden="true" /><span>Ravenclaw University</span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <details class="site-navigation" data-navigation-drawer data-desktop-query="(min-width: 1001px)" open>
                <summary aria-label="Main navigation"><span class="menu-lines" aria-hidden="true"></span><span class="sr-only">Menu</span></summary>
                <button class="navigation-backdrop" type="button" data-drawer-close tabindex="-1" aria-label="Close navigation"></button>
                <div class="navigation-panel" aria-label="Main navigation">
                <div class="drawer-heading"><partial name="_DrawerBrand" /><button type="button" class="drawer-close" data-drawer-close aria-label="Close navigation"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button></div>
                <nav class="portal-nav" aria-label="Main navigation">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="academics">Academics</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="leadership">Founder</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a>
                </nav>
                </div>
            </details>
            <details class="account-menu">
                <summary aria-label="Account options"><svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></svg></summary>
                <div class="account-dropdown">
                    <partial name="_AccountMenuIdentity" model="@(Context.Items[typeof(AccountMenuViewModel)] as AccountMenuViewModel ?? new AccountMenuViewModel(User.Identity?.Name ?? "Account", User.Identity?.Name ?? "", null))" />
                    <a class="account-profile-link" asp-controller="Profile" asp-action="Index">Edit personal information <span aria-hidden="true">›</span></a>
                    @if (User.IsInRole("Admin")) { <a asp-controller="UniversityInformation" asp-action="Index">Manage website <span aria-hidden="true">›</span></a> }
                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Sign out</button></form>
                </div>
            </details>
        }
        else { <a asp-controller="Account" asp-action="Login">Sign in</a> }
      </div>
    </header>
    <main id="main-content" class="portal-main @ViewData["MainClass"]">@RenderBody()</main>
    @if (IsSectionDefined("Footer")) { @await RenderSectionAsync("Footer", required: false) }
    else { <footer class="portal-footer">© @DateTime.UtcNow.Year Ravenclaw University <span>Where Wisdom Takes Flight.</span></footer> }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/navigation-drawer.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
